{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-yelp-review-slider/template",
	"version": "9.6",
	"title": "WP Yelp Review Slider",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Display a saved Yelp review slider, grid, or badge.",
	"keywords": [ "yelp", "reviews", "slider", "testimonials", "badge" ],
	"textdomain": "wp-yelp-review-slider",
	"attributes": {
		"templateId": {
			"type": "number",
			"default": 0
		}
	},
	"example": {
		"attributes": {
			"templateId": 0
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
